DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
BOT_NAME=绫地宁宁
BOT_HOST=127.0.0.1
BOT_PORT=8080

# Required. Must match the token in NapCat's HTTP CLIENT event reporting configuration.
# Generate each secret separately with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
ADMIN_QQ=
# Empty is denied; omit this variable to use ADMIN_QQ only.
# All allowed users may query the shared documents in assets/docs.
# ALLOWED_QQ=12345678,87654321
NAPCAT_URL=http://localhost:3000
NAPCAT_TOKEN=

# Optional. Empty disables the dashboard. Login username: admin.
DASHBOARD_TOKEN=

# Optional. Only ADMIN_QQ may confirm email drafts. No automatic retries.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RECEIVER_EMAIL=
